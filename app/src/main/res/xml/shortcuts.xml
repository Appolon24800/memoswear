<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_note"
        android:shortcutId="new_note"
        android:shortcutLongLabel="@string/shortcut_new_note_long"
        android:shortcutShortLabel="@string/shortcut_new_note">
        <intent
            android:action="dev.appolon.memoswear.action.NEW_NOTE"
            android:targetClass="dev.appolon.memoswear.ui.MainActivity"
            android:targetPackage="dev.appolon.memoswear">
            <extra
                android:name="dev.appolon.memoswear.extra.VOICE"
                android:value="false" />
        </intent>
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_voice"
        android:shortcutId="voice_note"
        android:shortcutLongLabel="@string/shortcut_voice_note_long"
        android:shortcutShortLabel="@string/shortcut_voice_note">
        <intent
            android:action="dev.appolon.memoswear.action.NEW_NOTE"
            android:targetClass="dev.appolon.memoswear.ui.MainActivity"
            android:targetPackage="dev.appolon.memoswear">
            <extra
                android:name="dev.appolon.memoswear.extra.VOICE"
                android:value="true" />
        </intent>
    </shortcut>
</shortcuts>
